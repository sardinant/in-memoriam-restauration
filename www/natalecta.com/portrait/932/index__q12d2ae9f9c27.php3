			'</a></td></tr>' +
					'<tr><td width=30% valign=top><a class=NewsLinks href=agenda_popup.php3?agenda_id=445 target=popup445 onClick=window.open("","popup445","width=300,height=400,left=100,top=100,scrollbars=1"); target=_blank>06/12/2006 - Lorient (56)'+
			'<table border="0" cellpadding="0" cellspacing="5">'+
        		'<tr><td class="corpstexte8"><b><a class=NewsHeader href=agenda_popup.php3?agenda_id=445 target=popup445 onClick=window.open("","popup445","width=300,height=400,left=100,top=100,scrollbars=1"); target=_blank>5è Salon du Livre Jeunesse Lorient</a></b></td></tr>'+
        		'<tr><td class="corpstexte6"></td></tr>'+
        		'</table>' +
			'</a></td></tr>' +
			'<tr><td width=30% valign=top><a class=NewsLinks href=agenda_popup.php3?agenda_id=440 target=popup440 onClick=window.open("","popup440","width=300,height=400,left=100,top=100,scrollbars=1"); target=_blank>06/12/2006 - Lorient (56)'+
			'<table border="0" cellpadding="0" cellspacing="5">'+
        		'<tr><td class="corpstexte8"><b><a class=NewsHeader href=agenda_popup.php3?agenda_id=440 target=popup440 onClick=window.open("","popup440","width=300,height=400,left=100,top=100,scrollbars=1"); target=_blank>Salons du LIvre e Jeunesse du Pays de Lorient</a></b></td></tr>'+

		        <td width="676"> <!-- begin of data -->
<script LANGUAGE="JavaScript">
        <!--
        // Citations Aléatoires Exemple JavaScript du SpeeDEricH.com
        // web : http://speederich.com
        
        
        champs = new Array(6);
        
        function LesCitations(citation,auteur) {
            this.citation = citation;
            this.auteur = auteur;
        }
        
        champs[0] = new LesCitations("Ecrire, c’est essayer de savoir ce que nous écririons si nous écrivions.","Marguerite Duras");
        champs[1] = new LesCitations("Le mot couleur est devenu en français moderne un mot extrèmement valorisant. Cela n'était pas le cas ni en ancien français ni en moyen français, qui l'associaient souvent à l'idée d'enveloppe, de fond, de d'éguisement, d'artifice et de tromperie (étymologiquement le mot color peut se rattacher à la famille du verbe celare qui signifie cacher)","Michel Pastoureau");
        champs[2] = new LesCitations("Je suis une histoire, Une mémoire qui s'invente, Je ne suis jamais seul, Je te parle toujours, Tu me parles toujours, J'avance dans le noir, Et je plante des signes","Octavio Paz, Versant Est, Gallimard, 1970");
        champs[3] = new LesCitations("Il faut leur parler d'égal à égal, écrire pour eux aussi clairement et simplement que possible","Charles Vildrac");
        champs[4] = new LesCitations("Les mots te porteront vers moi, Et à mon tour je poursuivrai les mots","");
        champs[5] = new LesCitations("Nothing is really work unless you would rather be doing something else.","James Matthew Barrie (1860-1937)");
        
       
        
        function Aleatoire(mini,maxi) {
            var x = -1;
        
            while (x < mini) {
                x = Math.round(Math.random() * maxi);
            }
        
            return x;
        }
        
        function Citation() {
            var x = Aleatoire(0,5);
        
            document.write('<I>');
            document.write(champs[x].citation);
            document.write('</I><BR><B>');
            document.write(champs[x].auteur);
            document.write('<B><BR>');
        }
        //-->
    </script><table width="680" border="0" cellspacing="3" cellpadding="0">
